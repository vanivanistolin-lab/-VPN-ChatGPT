{
  "version": "1.1.1",
  "manifest_version": 3,
  "action": {
    "default_title": "ChatGPT · VPN",
    "default_popup": "popup.html"
  },
  "name": "ChatGPT — обновление после VPN",
  "permissions": [
    "nativeMessaging",
    "alarms",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "key": ""
}